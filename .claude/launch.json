{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--bind",
        "127.0.0.1",
        "--directory",
        "dist/dronoids"
      ],
      "port": 8090
    },
    {
      "name": "site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "site/dronoids_site.py",
        "--config",
        "site/dev-config.json"
      ],
      "port": 8083
    },
    {
      "name": "world",
      "runtimeExecutable": "target/release/dronoids-server",
      "runtimeArgs": [
        "--port",
        "8082",
        "--bind",
        "127.0.0.1",
        "--bots",
        "2",
        "--save",
        "target/site-dev/primo.world",
        "--site-secret",
        "target/site-dev/secret"
      ],
      "port": 8082
    }
  ]
}
