; MINEUR+ -- comme le mineur, mais il regarde devant lui
; (LOOK) et contourne les obstacles au lieu de foncer dedans.

debut:
    CARGO a
    JGE a, FULL, maison
    DIST a, ORE
    JEQ a, NONE, explorer
    JLE a, 1, creuser
    SCAN b, ORE
    JMP aller
maison:
    DIST a, BASE
    JLE a, 1, vider
    SCAN b, BASE
aller:
    CALL libre           ; corrige le cap b si c'est bouché devant
    MOVE b
    JMP debut
creuser:
    MINE
    JMP debut
vider:
    DROP
    JMP debut

explorer:
    JNZ d, pas           ; d = cap d'exploration (0 = pas encore choisi)
    RAND d, 359
    INC d
pas:
    SET b, d
    CALL libre
    SET d, b
    MOVE b
    JMP debut

; libre : à partir du cap b, cherche un cap sans obstacle
; juste devant : b, b+40, b-40, b+80, b-80...
; Les drones se croisent : seuls WALL, ORE, BASE, EBASE bloquent.
libre:
    SET a, 0
essai:
    LOOK c, b
    JEQ c, EMPTY, trouve
    JEQ c, ALLY, trouve
    JEQ c, ENEMY, trouve
    INC a
    JGT a, 8, trouve     ; tant pis, on tente quand même
    SET c, a
    MOD c, 2
    JZ c, gauche
    SET c, a
    MUL c, 40
    ADD b, c
    JMP tourner
gauche:
    SET c, a
    MUL c, 40
    SUB b, c
tourner:
    MOD b, 360
    JMP essai
trouve:
    RET
